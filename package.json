{
  "name": "grammarme",
  "private": true,
  "version": "0.1.1",
  "description": "A free, private, Grammarly-style writing assistant. Local grammar checking with Harper, optional AI suggestions.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/site",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "eval": "node --experimental-strip-types tests/eval/run-eval.ts",
    "build:site": "npm run build -w apps/site"
  },
  "engines": {
    "node": ">=22.6"
  }
}
